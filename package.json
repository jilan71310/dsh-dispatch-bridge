{
  "name": "dsh-dispatch-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Writes this host's local authenticated URL and a workspace snapshot to ~/.dsh/dispatch/, so a local automation client can create sessions inside a chosen workspace, send prompts and read replies over the ordinary /api endpoints.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "automation",
    "dispatch",
    "agent"
  ],
  "license": "MIT",
  "author": "jilan71310",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jilan71310/dsh-dispatch-bridge.git"
  },
  "homepage": "https://github.com/jilan71310/dsh-dispatch-bridge#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
